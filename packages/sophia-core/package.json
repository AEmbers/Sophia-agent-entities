{
  "name": "@sophia/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AEmbers/Sophia-agent-entities.git",
    "directory": "packages/sophia-core"
  },
  "homepage": "https://github.com/AEmbers/Sophia-agent-entities#readme",
  "bugs": {
    "url": "https://github.com/AEmbers/Sophia-agent-entities/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-profile-bundle",
    "cordis",
    "agent-teams",
    "sophia"
  ],
  "description": "Sophia-agent-entities 基础包 + DSH 插件外壳：三层标识命名门禁、追加式账本、团队派生策略与两级审批、双模草案类型与角色模型；宿主半（@sophia/core/host）与浏览器半（exports[\"./client\"]）已可被 DSH 加载。",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "lib/plugin.js",
  "exports": {
    ".": {
      "types": "./lib/plugin.d.ts",
      "default": "./lib/plugin.js"
    },
    "./host": {
      "types": "./lib/host.d.ts",
      "default": "./lib/host.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build-client.json && tsdown",
    "build:clean": "npm run clean && npm run build",
    "prepack": "npm run build:clean",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "pretest": "node ../../scripts/seed-ui-primitives-stub.mjs",
    "test": "vitest run",
    "smoke:client": "node ../../scripts/sophia-client-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "lightningcss": "^1.33.0",
    "yaml": "^2.9.1"
  }
}
